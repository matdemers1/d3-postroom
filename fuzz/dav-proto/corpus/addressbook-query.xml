<?xml version="1.0" encoding="utf-8" ?>
<C:addressbook-query xmlns:D="DAV:" xmlns:C="urn:ietf:params:xml:ns:carddav">
  <D:prop><D:getetag/><C:address-data><C:prop name="FN"/><C:prop name="EMAIL"/></C:address-data></D:prop>
  <C:filter test="anyof">
    <C:prop-filter name="FN" test="allof"><C:text-match collation="i;unicode-casemap" match-type="starts-with">Ada</C:text-match></C:prop-filter>
    <C:prop-filter name="EMAIL"><C:text-match match-type="ends-with">@d3cloud.io</C:text-match><C:param-filter name="TYPE"><C:is-not-defined/></C:param-filter></C:prop-filter>
  </C:filter>
  <C:limit><C:nresults>20</C:nresults></C:limit>
</C:addressbook-query>
