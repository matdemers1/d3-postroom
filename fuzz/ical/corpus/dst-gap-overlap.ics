BEGIN:VCALENDAR
PRODID:-//Postroom//DST gap and overlap cases (PST-T-8.1)//EN
VERSION:2.0
BEGIN:VTIMEZONE
TZID:America/New_York
BEGIN:DAYLIGHT
DTSTART:20070311T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
END:DAYLIGHT
BEGIN:STANDARD
DTSTART:20071104T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:gap-single-dtend@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20260308T023000
DTEND;TZID=America/New_York:20260308T033000
SUMMARY:Starts in the spring-forward gap (DTEND)
END:VEVENT
BEGIN:VEVENT
UID:gap-single-duration@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20260308T023000
DURATION:PT1H
SUMMARY:Starts in the spring-forward gap (DURATION)
END:VEVENT
BEGIN:VEVENT
UID:gap-end-dtend@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20260308T013000
DTEND;TZID=America/New_York:20260308T023000
SUMMARY:Ends in the spring-forward gap
END:VEVENT
BEGIN:VEVENT
UID:gap-daily-dtend@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20260306T023000
DTEND;TZID=America/New_York:20260306T033000
RRULE:FREQ=DAILY;COUNT=5
SUMMARY:Daily at 02:30; the third instance lands in the gap (DTEND)
END:VEVENT
BEGIN:VEVENT
UID:gap-daily-duration@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20260306T023000
DURATION:PT1H
RRULE:FREQ=DAILY;COUNT=5
SUMMARY:Daily at 02:30; the third instance lands in the gap (DURATION)
END:VEVENT
BEGIN:VEVENT
UID:overlap-single-dtend@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20261101T013000
DTEND;TZID=America/New_York:20261101T023000
SUMMARY:Starts at the ambiguous 01:30 on fall-back day
END:VEVENT
BEGIN:VEVENT
UID:overlap-daily-dtend@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20261030T013000
DTEND;TZID=America/New_York:20261030T023000
RRULE:FREQ=DAILY;COUNT=4
SUMMARY:Daily at 01:30 across the fall-back (DTEND)
END:VEVENT
BEGIN:VEVENT
UID:overlap-daily-duration@example.com
DTSTAMP:20260101T000000Z
DTSTART;TZID=America/New_York:20261030T013000
DURATION:PT1H
RRULE:FREQ=DAILY;COUNT=4
SUMMARY:Daily at 01:30 across the fall-back (DURATION)
END:VEVENT
END:VCALENDAR
