{
  "name": "@postroom/api",
  "private": true,
  "version": "0.0.0",
  "description": "HTTP API and web login: dual login, admin, setup",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --conditions=source --import tsx --watch src/main.ts",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "openapi": "node --conditions=source --import tsx src/openapi/generate.ts",
    "openapi:check": "node --conditions=source --import tsx src/openapi/generate.ts --check"
  },
  "dependencies": {
    "@d3cloudio/auth-client": "0.1.1",
    "@postroom/alerts": "workspace:*",
    "@postroom/audit": "workspace:*",
    "@postroom/blobstore": "workspace:*",
    "@postroom/classifier": "workspace:*",
    "@postroom/config": "workspace:*",
    "@postroom/credentials": "workspace:*",
    "@postroom/crypto": "workspace:*",
    "@postroom/daemon": "workspace:*",
    "@postroom/dav-store": "workspace:*",
    "@postroom/db": "workspace:*",
    "@postroom/delivery": "workspace:*",
    "@postroom/dsn": "workspace:*",
    "@postroom/ical": "workspace:*",
    "@postroom/imip": "workspace:*",
    "@postroom/managesieve": "workspace:*",
    "@postroom/mime": "workspace:*",
    "@postroom/pgp": "workspace:*",
    "@postroom/phish": "workspace:*",
    "@postroom/queue": "workspace:*",
    "@postroom/search": "workspace:*",
    "@postroom/submission": "workspace:*",
    "@postroom/threading": "workspace:*",
    "@postroom/trackers": "workspace:*",
    "@postroom/vcard": "workspace:*",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "@types/pg": "^8.23.1",
    "@postroom/auth-throttle": "workspace:*"
  }
}
