    "@postroom/auth-throttle": "workspace:*",
    "@postroom/blobstore": "workspace:*",
    "@postroom/crypto": "workspace:*",
    "@postroom/mime": "workspace:*",
    "@postroom/search": "workspace:*",
    "@postroom/proxy-protocol": "workspace:*",
    "@postroom/audit": "workspace:*",
    "@postroom/dsn": "workspace:*",
    "@postroom/dav-store": "workspace:*",
    "@postroom/auth-checks": "workspace:*",
    "pg": "^8.23.0",
    "@postroom/classifier": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "@types/pg": "^8.23.1"
