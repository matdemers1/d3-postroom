{
  "name": "@postroom/delivery",
  "private": true,
  "version": "0.0.0",
  "description": "Outbound delivery queue",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --conditions=source --import tsx --watch src/main.ts",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@postroom/daemon": "workspace:*",
    "@postroom/db": "workspace:*",
    "@postroom/queue": "workspace:*",
    "@postroom/dns": "workspace:*",
    "@postroom/blobstore": "workspace:*",
    "@postroom/crypto": "workspace:*",
    "@postroom/smtp-proto": "workspace:*",
    "@postroom/auth-checks": "workspace:*",
    "@postroom/audit": "workspace:*",
    "@postroom/dsn": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "source": "./src/transports/fake.ts",
      "types": "./dist/transports/fake.d.ts",
      "default": "./dist/transports/fake.js"
    },
    "./ses-feedback": {
      "source": "./src/ses-feedback/index.ts",
      "types": "./dist/ses-feedback/index.d.ts",
      "default": "./dist/ses-feedback/index.js"
    },
    "./ses-feedback/testing": {
      "source": "./src/ses-feedback/testing.ts",
      "types": "./dist/ses-feedback/testing.d.ts",
      "default": "./dist/ses-feedback/testing.js"
    }
  }
}
