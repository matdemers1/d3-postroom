{
  "name": "@postroom/submission",
  "private": true,
  "version": "0.0.0",
  "description": "Authenticated submission on :465/:587",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./dkim": {
      "source": "./src/dkim.ts",
      "types": "./dist/dkim.d.ts",
      "default": "./dist/dkim.js"
    },
    "./caps": {
      "source": "./src/caps/index.ts",
      "types": "./dist/caps/index.d.ts",
      "default": "./dist/caps/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --conditions=source --import tsx --watch src/main.ts",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@postroom/daemon": "workspace:*",
    "@postroom/db": "workspace:*",
    "@postroom/credentials": "workspace:*",
    "@postroom/smtp-proto": "workspace:*",
    "@postroom/delivery": "workspace:*",
    "@postroom/blobstore": "workspace:*",
    "@postroom/crypto": "workspace:*",
    "@postroom/auth-checks": "workspace:*",
    "@postroom/audit": "workspace:*",
    "@postroom/auth-throttle": "workspace:*",
    "@postroom/alerts": "workspace:*",
    "@postroom/dav-store": "workspace:*",
    "@postroom/mime": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
