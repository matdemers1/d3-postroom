{
  "name": "postroom",
  "private": true,
  "version": "0.0.0",
  "description": "A hand-rolled mail server and webmail: SMTP, submission, IMAP, CalDAV/CardDAV and Sieve written from scratch in TypeScript, with an inbox that sorts itself and shows its working.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "eslint vitest.shared.ts && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present --filter '!@postroom/e2e' test",
    "build": "pnpm -r --if-present build",
    "test:integration": "pnpm -r --if-present --workspace-concurrency=1 test:integration",
    "fuzz:smoke": "node scripts/fuzz-smoke.mjs",
    "e2e": "pnpm --filter @postroom/e2e test",
    "fuzz:nightly": "node scripts/fuzz-nightly.mjs",
    "check:corpus": "node scripts/check-no-corpus.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "4.0.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
