{
  "name": "postroom",
  "private": true,
  "version": "0.0.0",
  "description": "A hand-rolled mail server and webmail: SMTP, submission, IMAP, CalDAV/CardDAV and Sieve written from scratch in TypeScript, with an inbox that sorts itself and shows its working.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
