# Postroom — copy to .env on the host (mode 600). Nothing here is ever committed with values.

# Database
DATABASE_URL=postgres://postroom:change-me@postgres:5432/postroom

# Key-encryption key for blobs and DKIM keys (PST-ADR-009). 32 bytes, base64.
POSTROOM_KEK=

# Web login (dual login: app-native + D3 Auth)
SESSION_SECRET=
PASSWORD_PEPPER=
D3AUTH_ISSUER=https://auth.d3cloud.io
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=

# Hostnames
MX_HOSTNAME=mx.d3cloud.io
WEB_ORIGIN=https://mail.d3cloud.io
USERCONTENT_ORIGIN=
DAV_ORIGIN=https://dav.d3cloud.io

# Edge (PST-ADR-002)
WG_PRIVATE_KEY=
WG_EDGE_PUBLIC_KEY=
WG_EDGE_ENDPOINT=
EDGE_PEER_ADDRESS=10.77.0.1

# ACME via delegated challenge zone (PST-ADR-010)
ACME_CF_TOKEN=
ACME_CHALLENGE_ZONE=

# Spam defense
SPAMHAUS_DQS_KEY=

# SES fallback transport (PST-ADR-003)
SES_SMTP_USER=
SES_SMTP_PASSWORD=
SES_REGION=us-east-1

# Backups (S3, SSE-KMS, put-only IAM user)
BACKUP_BUCKET=
BACKUP_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Alerts go out via the D3 Auth Cloudflare mail relay, never Postroom's own queue (PST-REQ-096)
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
ALERT_TO=
