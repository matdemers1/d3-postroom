# Keys never belong in the repo: KEK, DKIM, WireGuard, ACME account.
*.key
*.pem
# Except the throwaway S/MIME test CA and identity that decrypt packages/pgp's committed fixtures
# (example.test addresses, regenerated by make-fixtures.sh; also allowlisted in .gitleaks.toml).
!packages/pgp/test/fixtures/carol-smime.pem
!packages/pgp/test/fixtures/carol-smime.TEST-ONLY.key.pem
!packages/pgp/test/fixtures/smime-root.pem
!packages/pgp/test/fixtures/smime-intermediate.pem
keys/
# …but not the source directories for the Keys feature (PST-T-12.2).
!apps/api/src/keys/
!apps/web/src/keys/
edge/*.wg.conf

# The private calibration corpus is real mail. It is never committed (PST-REQ-108).
# Only fixtures/golden (synthetic) is.
corpus/
# Fuzz seed corpora are synthetic protocol commands, not mail: tracked on purpose.
!fuzz/*/corpus/
fixtures/private/

# Downloaded at test time only — no licence to redistribute, never sent into a live system.
fixtures/spamassassin/

# Fuzzer working state; crashers are promoted to fixtures by hand.
fuzz/.work/
.claude/worktrees/
edge/.secrets/
