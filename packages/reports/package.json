{
  "name": "@postroom/reports",
  "private": true,
  "version": "0.0.0",
  "description": "DMARC aggregate (RFC 7489 Appendix C) and TLS-RPT (RFC 8460) report parsers: a strict XXE-proof XML reader, bounded gzip/zip unwrapping, normalized report shapes",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {}
}
