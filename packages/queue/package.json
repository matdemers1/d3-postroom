{
  "name": "@postroom/queue",
  "private": true,
  "version": "0.0.0",
  "description": "Postgres job queue: enqueue, claim with SKIP LOCKED, retry with jittered backoff, LISTEN/NOTIFY wakeups",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@postroom/db": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
