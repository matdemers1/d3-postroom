// Postroom core schema (PST-T-0.4). One database shape every daemon shares.
//
// Invariants the SQL migration also enforces with CHECK constraints, because a daemon that writes
// raw SQL must not be able to break them either:
//   - domain names, address local parts and blob digests are stored lowercased (PST-REQ-012);
//   - mailbox.uidvalidity > 0, mailbox.uidnext >= 1, modseqs >= 0 (RFC 9051, RFC 7162);
//   - blob.refcount >= 0. A blob row is never modified except for its refcount (PST-REQ-012);
//   - identity links are unique by (issuer, subject), never by email (PST-REQ-005).
//
// The database holds only a blob's *wrapped* DEK. The KEK that unwraps it is never written here
// (PST-REQ-010). Every mutation writes an audit_event row, which is append-only (PST-REQ-009).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum AddressKind {
  primary
  alias
  masked
  service

  @@map("address_kind")
}

enum SpecialUse {
  inbox
  sent
  drafts
  trash
  junk
  archive
  rejects

  @@map("special_use")
}

enum AccountKind {
  person
  service

  @@map("account_kind")
}

enum DkimAlgorithm {
  rsa_sha256     @map("rsa-sha256")
  ed25519_sha256 @map("ed25519-sha256")

  @@map("dkim_algorithm")
}

enum JobStatus {
  pending
  running
  done
  failed
  dead

  @@map("job_status")
}

enum RecipientState {
  queued
  attempting
  deferred
  delivered
  bounced
  cancelled

  @@map("recipient_state")
}

enum InboundState {
  spooled
  processing
  filed
  rejected
  failed

  @@map("inbound_state")
}

enum AppPasswordScope {
  imap
  smtp
  dav
  sieve

  @@map("app_password_scope")
}

enum DavCollectionKind {
  calendar
  addressbook

  @@map("dav_collection_kind")
}

enum ActorKind {
  account
  system
  service
  anonymous

  @@map("actor_kind")
}

// ─── Accounts and identity ────────────────────────────────────────────────

model Account {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName  String      @map("display_name")
  isAdmin      Boolean     @default(false) @map("is_admin")
  /// Argon2id hash (peppered). Null for a D3-Auth-only account, or before /setup sets it.
  passwordHash String?     @map("password_hash")
  /// TOTP secret, encrypted at rest. Null until enrolment.
  totpSecret   Bytes?      @map("totp_secret")
  totpEnabled  Boolean     @default(false) @map("totp_enabled")
  /// The last TOTP time step accepted, so a code cannot be replayed within its window.
  totpLastStep BigInt?     @map("totp_last_step")
  disabledAt   DateTime?   @map("disabled_at") @db.Timestamptz(6)
  /// A person, or a service mailbox an ecosystem app submits through (PST-T-1.12).
  kind         AccountKind @default(person)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  outboundMessages OutboundMessage[]
  threads          Thread[]
  identityLinks    IdentityLink[]
  addresses        Address[]
  addressTargets   AddressTarget[]
  mailboxes        Mailbox[]
  appPasswords     AppPassword[]
  sessions         Session[]
  auditEvents      AuditEvent[]

  // PST-T-5.3: per-account naive Bayes.
  bayesTrainingEvents  BayesTrainingEvent[]
  bayesTrainedMessages BayesTrainedMessage[]
  bayesTokens          BayesToken[]
  bayesBucketTotals    BayesBucketTotal[]

  // PST-T-7.7: per-mailbox retention.
  retentionPolicies RetentionPolicy[]
  // PST-T-5.4: sender pins and the new-sender screen (Allow/Block).
  senderPins SenderPin[]

  // PST-T-8.2: CalDAV calendars and CardDAV address books.
  davCollections DavCollection[]

  @@map("account")
}

/// A sender pin (PST-REQ-105) and/or a new-sender screen decision (PST-REQ-106), per account and
/// normalized sender address. `bucket` is set when the user pinned this sender to a bucket — it
/// overrides the classifier entirely (@postroom/classifier's bucketFor consults it before rules and
/// Bayes). `screen` is set from the new-sender badge's Allow/Block: `block` routes this sender's
/// future mail to Junk (via the account's blocked-pins signal, same as a bucket pin of `junk`, but
/// unauthenticated mail is not exempt — junking a spoofer is harmless); `allow` treats the sender as
/// a known contact, so a directly-addressed message from them can reach Priority. Either or both may
/// be set on the same row; at least one is expected to be non-null in practice.
model SenderPin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  /// Lowercased, +tag-stripped (@postroom/classifier's normalizeAddress).
  address   String
  /// priority | people | newsletters | updates | receipts | notifications | junk
  bucket    String?
  /// allow | block
  screen    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, address])
  @@index([accountId])
  @@map("sender_pin")
}

/// An external identity (D3 Auth OIDC) linked by (issuer, subject). Email is informational only.
model IdentityLink {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  issuer     String
  subject    String
  email      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([accountId])
  @@map("identity_link")
}

/// A protocol credential. IMAP/SMTP/DAV/Sieve accept these only, never the account password.
model AppPassword {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String             @map("account_id") @db.Uuid
  label             String
  /// Public lookup prefix, so verification hashes one candidate rather than all of them.
  prefix            String             @unique
  hash              String
  scopes            AppPasswordScope[]
  lastUsedAt        DateTime?          @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp        String?            @map("last_used_ip")
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(6)
  /// Recipients this credential may submit per rolling 24 hours (PST-T-1.10). Null = the default.
  dailyRecipientCap Int?               @map("daily_recipient_cap")
  /// Set when the cap tripped; submission holds mail until an admin thaws it.
  frozenAt          DateTime?          @map("frozen_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  outboundMessages OutboundMessage[]

  @@index([accountId])
  @@map("app_password")
}

/// A web session. The id is stored hashed; the cookie holds the only copy of the raw token.
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idHash      String    @unique @map("id_hash")
  accountId   String    @map("account_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  stepUpAt    DateTime? @map("step_up_at") @db.Timestamptz(6)
  ip          String?
  userAgent   String?   @map("user_agent")
  /// How this session signed in: "password" (with TOTP) or "oidc".
  method      String    @default("password")
  /// The D3 Auth `roles` claim at sign-in, for the admin gate (PST-REQ-007). Empty for password.
  roles       String[]  @default([])
  /// For an OIDC session: the identity it came from, so back-channel logout can find it.
  oidcIssuer  String?   @map("oidc_issuer")
  oidcSubject String?   @map("oidc_subject")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([oidcIssuer, oidcSubject])
  @@map("session")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("setting")
}

// ─── Domains and addresses ────────────────────────────────────────────────

model Domain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase; CHECK-enforced.
  name      String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  addresses Address[]
  dkimKeys  DkimKey[]

  @@map("domain")
}

/// An address at one of our domains. primary/service/masked addresses belong to one account;
/// an alias fans out to one or more accounts through address_target.
model Address {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase; CHECK-enforced.
  localPart String      @map("local_part")
  domainId  String      @map("domain_id") @db.Uuid
  kind      AddressKind
  /// Owner for primary, masked and service addresses. Null for an alias.
  accountId String?     @map("account_id") @db.Uuid
  /// The site a masked address was handed to.
  siteTag   String?     @map("site_tag")
  killedAt  DateTime?   @map("killed_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  domain  Domain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  account Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  targets AddressTarget[]

  @@unique([localPart, domainId])
  @@index([accountId])
  @@map("address")
}

model AddressTarget {
  addressId String   @map("address_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([addressId, accountId])
  @@index([accountId])
  @@map("address_target")
}

// ─── Mail store ───────────────────────────────────────────────────────────

model Mailbox {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String      @map("account_id") @db.Uuid
  name          String
  specialUse    SpecialUse? @map("special_use")
  uidvalidity   Int
  uidnext       Int         @default(1)
  highestModseq BigInt      @default(0) @map("highest_modseq")
  subscribed    Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages        Message[]
  expunged        ExpungedMessage[]
  retentionPolicy RetentionPolicy?

  @@unique([accountId, name])
  @@map("mailbox")
}

/// How long a mailbox keeps a message (PST-T-7.7, PST-REQ-129). A row overrides the built-in default
/// for the mailbox's special use (Junk 30 d, Trash 30 d, Rejects 14 d; every other mailbox: forever).
/// `days` null keeps messages forever (turns a default off). Expiry never deletes outside Trash and
/// Rejects: any other mailbox's expired messages MOVE to Trash, where the clock starts again.
model RetentionPolicy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  mailboxId String   @unique @map("mailbox_id") @db.Uuid
  days      Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("retention_policy")
}

/// One message in one mailbox. The raw RFC 5322 bytes live in the blob, never here.
model Message {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mailboxId        String    @map("mailbox_id") @db.Uuid
  uid              Int
  modseq           BigInt
  blobSha256       String    @map("blob_sha256")
  size             Int
  internalDate     DateTime  @map("internal_date") @db.Timestamptz(6)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  /// System flags (\Seen, \Answered, ...) and keywords, as IMAP spells them.
  flags            String[]  @default([])
  /// The inbound spool row this copy was filed from; unique per mailbox so a replayed "file" stage
  /// can never file the same message twice (PST-T-2.7).
  inboundMessageId String?   @map("inbound_message_id") @db.Uuid
  /// Denormalised from the headers at filing time, for lists and search.
  messageIdHeader  String?   @map("message_id_header")
  subject          String?
  fromAddress      String?   @map("from_address")
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  /// Threading headers (PST-T-3.8): In-Reply-To's first msg-id and the References chain.
  inReplyTo        String?   @map("in_reply_to")
  references       String[]  @default([])
  threadId         String?   @map("thread_id") @db.Uuid
  /// When the message entered a Trash mailbox — the visible clock of PST-REQ-129. Stamped by a
  /// trigger on every insert into / move into Trash (any surface), cleared on a move out.
  trashedAt        DateTime? @map("trashed_at") @db.Timestamptz(6)

  mailbox Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  blob    Blob            @relation(fields: [blobSha256], references: [sha256], onDelete: Restrict)
  inbound InboundMessage? @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)
  thread  Thread?         @relation(fields: [threadId], references: [id], onDelete: SetNull)
  search  MessageSearch?
  verdict MessageVerdict?

  @@unique([mailboxId, inboundMessageId])
  @@unique([mailboxId, uid])
  @@index([threadId])
  @@index([messageIdHeader])
  @@index([mailboxId, modseq])
  @@index([blobSha256])
  @@index([mailboxId, receivedAt])
  @@index([mailboxId, trashedAt])
  @@map("message")
}

/// Content-addressed, encrypted raw message. Named by SHA-256 of the plaintext (lowercase hex).
/// Immutable except for refcount; storing the same message twice yields one row, refcount 2.
model Blob {
  sha256     String   @id
  size       Int
  /// This blob's DEK, wrapped by the KEK. The KEK itself is never in the database.
  wrappedDek Bytes    @map("wrapped_dek")
  /// Identifier of the KEK that wrapped the DEK, so a rotation knows what to rewrap.
  kekId      String   @map("kek_id")
  /// AEAD algorithm of the blob body, e.g. "aes-256-gcm".
  aead       String
  nonce      Bytes
  refcount   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  messages Message[]

  @@map("blob")
}

// ─── Audit ────────────────────────────────────────────────────────────────

/// Append-only record of every mutation, from any surface (PST-REQ-009).
model AuditEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at             DateTime  @default(now()) @db.Timestamptz(6)
  actorAccountId String?   @map("actor_account_id") @db.Uuid
  actorKind      ActorKind @map("actor_kind")
  action         String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")

  actor Account? @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorAccountId])
  @@map("audit_event")
}

// ─── PST-P-1: DKIM keys, the job queue, the outbound queue ───────────────────────────────────────

/// A DKIM signing key. The private key is sealed by the KEK (PST-REQ-039); the database never holds
/// it in the clear. Selectors are dated so rotation can overlap (PST-T-7.4).
model DkimKey {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId      String        @map("domain_id") @db.Uuid
  selector      String
  algorithm     DkimAlgorithm
  /// The value published in DNS: `v=DKIM1; k=…; p=…`.
  dnsRecord     String        @map("dns_record")
  /// PKCS#8 DER sealed with the KEK, aad = "dkim:<domain>:<selector>".
  sealedPrivate Bytes         @map("sealed_private")
  kekId         String        @map("kek_id")
  /// When the key started signing. For a `pending` key: its creation time, overwritten at the switch.
  activeFrom    DateTime      @default(now()) @map("active_from") @db.Timestamptz(6)
  retiredAt     DateTime?     @map("retired_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Rotation (PST-T-7.4, PST-REQ-125): only `active` signs, one per (domain, algorithm).
  state         DkimKeyState  @default(active)
  /// When our resolver first saw this key's TXT with the matching p= (the switch happened then).
  dnsVerifiedAt DateTime?     @map("dns_verified_at") @db.Timestamptz(6)
  /// A `retiring` key becomes `retired` no earlier than this (switch + 7 days).
  retireAfter   DateTime?     @map("retire_after") @db.Timestamptz(6)

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@unique([domainId, selector])
  @@index([domainId, algorithm, state])
  @@map("dkim_key")
}

/// A DKIM key's place in rotation: pending (created, TXT not yet seen in DNS) → active (signing) →
/// retiring (superseded, still published for 7 days) → retired (the TXT may be removed).
enum DkimKeyState {
  pending
  active
  retiring
  retired

  @@map("dkim_key_state")
}

/// The Postgres job queue every stage runs on (PST-T-1.5, PST-T-2.7): claimed with
/// FOR UPDATE SKIP LOCKED, retried with backoff, replayable, and idempotent by key.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue          String
  payload        Json
  status         JobStatus @default(pending)
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(10) @map("max_attempts")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy       String?   @map("locked_by")
  lastError      String?   @map("last_error")
  /// A second enqueue with the same key is a no-op, so a crashed producer can safely retry.
  idempotencyKey String?   @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([queue, status, runAt])
  @@map("job")
}

/// A message accepted for outbound delivery: the raw bytes (DKIM-signed) live in the blob store.
model OutboundMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  appPasswordId String?  @map("app_password_id") @db.Uuid
  /// RFC 5321 reverse-path; empty string for the null sender (DSNs).
  envelopeFrom  String   @map("envelope_from")
  headerFrom    String   @map("header_from")
  messageId     String?  @map("message_id")
  subject       String?
  blobSha256    String   @map("blob_sha256")
  size          Int
  /// DSN parameters from MAIL FROM (RFC 3461): RET=FULL|HDRS and ENVID.
  dsnRet        String?  @map("dsn_ret")
  dsnEnvid      String?  @map("dsn_envid")
  submittedVia  String   @map("submitted_via")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account     Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  appPassword AppPassword?        @relation(fields: [appPasswordId], references: [id], onDelete: SetNull)
  recipients  OutboundRecipient[]

  @@index([accountId, createdAt])
  @@map("outbound_message")
}

/// One recipient of an outbound message, with its own state machine (the data model's lifecycle).
model OutboundRecipient {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboundMessageId String         @map("outbound_message_id") @db.Uuid
  address           String
  domain            String
  state             RecipientState @default(queued)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastCode          Int?           @map("last_code")
  lastEnhanced      String?        @map("last_enhanced")
  lastText          String?        @map("last_text")
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(6)
  delayDsnSentAt    DateTime?      @map("delay_dsn_sent_at") @db.Timestamptz(6)
  failureDsnSentAt  DateTime?      @map("failure_dsn_sent_at") @db.Timestamptz(6)
  /// DSN NOTIFY (RFC 3461); null = the default (FAILURE,DELAY).
  dsnNotify         String?        @map("dsn_notify")
  /// Which transport to use: direct MX, or the SES fallback (PST-ADR-003).
  transport         String         @default("direct")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  message     OutboundMessage   @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)
  attemptsLog DeliveryAttempt[]

  @@index([state, nextAttemptAt])
  @@index([outboundMessageId])
  @@map("outbound_recipient")
}

/// Every attempt to hand a recipient to a remote MX, with what the wire said (PST-T-1.13).
model DeliveryAttempt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  transport      String
  mxHost         String?   @map("mx_host")
  mxIp           String?   @map("mx_ip")
  localIp        String?   @map("local_ip")
  tlsVersion     String?   @map("tls_version")
  tlsCipher      String?   @map("tls_cipher")
  tlsPeer        String?   @map("tls_peer")
  remoteCode     Int?      @map("remote_code")
  remoteEnhanced String?   @map("remote_enhanced")
  remoteText     String?   @map("remote_text")
  /// delivered | deferred | bounced | error
  outcome        String
  error          String?

  recipient OutboundRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, startedAt])
  @@map("delivery_attempt")
}

// ─── PST-P-2: the inbound spool, verdicts, greylisting ───────────────────────────────────────────

/// One SMTP connection to smtp-in, as the daemon saw it (the real client from PROXY v2).
model InboundSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  clientIp  String    @map("client_ip")
  proxied   Boolean   @default(false)
  helo      String?
  rdns      String?
  tls       String?

  messages InboundMessage[]

  @@index([startedAt])
  @@index([clientIp, startedAt])
  @@map("inbound_session")
}

/// A message smtp-in accepted (250) or hard-rejected with a Rejects copy. The row and its blob are
/// committed before the 250 (PST-REQ-060); the worker's stages take it from `spooled` to `filed`.
model InboundMessage {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String?      @map("session_id") @db.Uuid
  receivedAt        DateTime     @default(now()) @map("received_at") @db.Timestamptz(6)
  envelopeFrom      String       @map("envelope_from")
  /// [{ address, accountIds, kind, tag? }] as resolved at RCPT time.
  recipients        Json
  blobSha256        String       @map("blob_sha256")
  size              Int
  state             InboundState @default(spooled)
  /// SPF, DKIM[], DMARC, ARC, DNSBL, attachment policy — each with its reasons.
  verdicts          Json         @default("{}")
  /// accept | reject | quarantine, and why.
  disposition       String       @default("accept")
  dispositionReason String?      @map("disposition_reason")
  /// The SMTP reply actually sent to the client.
  smtpReply         String?      @map("smtp_reply")
  lastError         String?      @map("last_error")
  filedAt           DateTime?    @map("filed_at") @db.Timestamptz(6)
  /// When this spool row's blob reference was released (PST-T-7.7): after every Message copy of the
  /// blob is gone, so the last reference can go and the blob be crypto-shredded (PST-REQ-130).
  blobReleasedAt    DateTime?    @map("blob_released_at") @db.Timestamptz(6)

  session  InboundSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([state, receivedAt])
  @@map("inbound_message")
}

/// Why a filed message looks the way it does: authentication, attachment policy, and (P5) the
/// bucket decision. Sorting decisions always store their reasons (PST-ADR-007).
model MessageVerdict {
  messageId   String   @id @map("message_id") @db.Uuid
  auth        Json     @default("{}")
  attachments Json     @default("[]")
  bucket      String?
  reasons     String[] @default([])
  /// The scores behind the bucket decision (rule signals, Bayes probabilities), PST-REQ-103.
  scores      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_verdict")
}

/// Greylisting triplets (client /24 or /64, envelope sender, recipient), hashed (PST-T-2.8).
model GreylistEntry {
  key       String    @id
  firstSeen DateTime  @default(now()) @map("first_seen") @db.Timestamptz(6)
  passedAt  DateTime? @map("passed_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("greylist_entry")
}

// ─── PST-P-3: threads and search ─────────────────────────────────────────────────────────────────

/// A conversation per account, built by JWZ threading over Message-ID/References/In-Reply-To with a
/// subject fallback (PST-T-3.8). Spans mailboxes: a reply in Sent joins the thread in INBOX.
model Thread {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  subject       String?
  /// The normalised base subject used for the subject fallback (Re:/Fwd: stripped).
  baseSubject   String?  @map("base_subject")
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  messageCount  Int      @default(0) @map("message_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([accountId, lastMessageAt])
  @@index([accountId, baseSubject])
  @@map("thread")
}

/// The searchable text of a message (PST-T-3.7), written by the parse stage. `tsv` is a generated
/// column (see the migration); pg_trgm indexes back substring and fuzzy matches.
model MessageSearch {
  messageId       String                   @id @map("message_id") @db.Uuid
  accountId       String                   @map("account_id") @db.Uuid
  subject         String                   @default("")
  fromText        String                   @default("") @map("from_text")
  toText          String                   @default("") @map("to_text")
  /// Plain text of the body (HTML converted), capped at 256 KiB.
  bodyText        String                   @default("") @map("body_text")
  hasAttachment   Boolean                  @default(false) @map("has_attachment")
  attachmentNames String                   @default("") @map("attachment_names")
  /// Generated by Postgres from the columns above (see the migration); never written directly.
  tsv             Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('simple'::regconfig, COALESCE(subject, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, ((COALESCE(from_text, ''::text) || ' '::text) || COALESCE(to_text, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(attachment_names, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(body_text, ''::text)), 'D'::\"char\"))"))

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([tsv], map: "message_search_tsv_idx", type: Gin)
  @@index([subject(ops: raw("gin_trgm_ops"))], map: "message_search_subject_trgm_idx", type: Gin)
  @@index([fromText(ops: raw("gin_trgm_ops"))], map: "message_search_from_trgm_idx", type: Gin)
  @@index([bodyText(ops: raw("gin_trgm_ops"))], map: "message_search_body_trgm_idx", type: Gin)
  @@map("message_search")
}

/// UIDs removed from a mailbox by EXPUNGE or MOVE, with the modseq of the removal, so QRESYNC can
/// answer VANISHED (EARLIER) (RFC 7162 §3.2.10). Pruned with the mailbox; never read for anything else.
model ExpungedMessage {
  mailboxId String   @map("mailbox_id") @db.Uuid
  uid       Int
  modseq    BigInt
  at        DateTime @default(now()) @db.Timestamptz(6)

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@id([mailboxId, uid])
  @@index([mailboxId, modseq])
  @@map("expunged_message")
}

// ─── PST-P-5: per-account naive Bayes (PST-T-5.3) ─────────────────────────────────────────────────

/// A user moved a message between two sorting buckets, from any client (PST-REQ-104): written in the
/// same transaction as the move by the IMAP server (MOVE, UID MOVE, COPY then EXPUNGE) and the
/// webmail API; the worker's training consumer applies it to the counts, in id order, and stamps
/// processedAt in the same transaction. The row is the record of the training (moves are not audited
/// one by one — see apps/imap/src/store.ts).
model BayesTrainingEvent {
  /// Ordering: a later move of the same message always has a larger id (it waits on the mailbox lock).
  id          BigInt    @id @default(autoincrement())
  accountId   String    @map("account_id") @db.Uuid
  /// The message after the move. No foreign key: it may be moved again or expunged before the
  /// consumer runs, and the event must outlive it.
  messageId   String    @map("message_id") @db.Uuid
  /// The trained document's identity: the same bytes are the same document wherever they are filed.
  blobSha256  String    @map("blob_sha256")
  fromBucket  String    @map("from_bucket")
  toBucket    String    @map("to_bucket")
  /// imap-move | imap-copy-expunge | web
  via         String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  /// trained | retrained | unchanged | skipped: <why>
  outcome     String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([processedAt, id])
  @@index([accountId])
  @@map("bayes_training_event")
}

/// Which bucket a document is trained into, and exactly the tokens that training added — so a move
/// back subtracts precisely what was added, and a replayed event changes nothing.
model BayesTrainedMessage {
  accountId  String   @map("account_id") @db.Uuid
  blobSha256 String   @map("blob_sha256")
  bucket     String
  tokens     String[]
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, blobSha256])
  @@map("bayes_trained_message")
}

/// How often a token was trained into a bucket, per account. Rows at zero are deleted.
model BayesToken {
  accountId String @map("account_id") @db.Uuid
  bucket    String
  token     String
  count     Int

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, bucket, token])
  @@index([accountId, token])
  @@map("bayes_token")
}

/// Documents and tokens trained into a bucket, per account.
model BayesBucketTotal {
  accountId String @map("account_id") @db.Uuid
  bucket    String
  docs      Int    @default(0)
  tokens    Int    @default(0)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, bucket])
  @@map("bayes_bucket_total")
}

// ─── CalDAV / CardDAV (PST-T-8.2, PST-REQ-132, PST-REQ-133) ─────────────────

/// A calendar (RFC 4791) or an address book (RFC 6352) of one account. Every person account gets a
/// "Calendar" and a "Contacts" collection when it is created (a trigger on account, which also
/// covers accounts created before this table existed via the migration's backfill).
model DavCollection {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String            @map("account_id") @db.Uuid
  kind        DavCollectionKind
  /// The collection's URL segment under the account's home set (decoded; `calendar`, a client UUID).
  slug        String
  displayName String            @map("display_name")
  description String?
  /// Apple's calendar-color, e.g. `#FF2968FF`.
  color       String?
  /// Apple's calendar-order.
  sortOrder   Int?              @map("sort_order")
  /// Supported calendar components (VEVENT, VTODO, VJOURNAL); empty for an address book.
  components  String[]          @default([])
  /// Properties a client set that the server does not interpret (calendar-timezone, …), as
  /// `{ "{ns}name": <element tree> }`. Size-capped by the daemon.
  deadProps   Json              @default("{}") @map("dead_props")
  /// The last change sequence number: the sync token (RFC 6578) and the getctag. Only grows.
  syncSeq     BigInt            @default(0) @map("sync_seq")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  resources DavResource[]
  changes   DavChange[]

  @@unique([accountId, kind, slug])
  @@index([accountId])
  @@map("dav_collection")
}

/// One calendar object resource (an .ics) or address object resource (a .vcf). The bytes the client
/// PUT are stored verbatim but encrypted: `data` is AES-256-GCM under a per-resource DEK, and the DEK
/// is wrapped by the KEK (PST-ADR-009). Deleting the row crypto-shreds it. The AAD of both is
/// `dav-resource:<id>`, so a ciphertext cannot be moved to another row.
model DavResource {
  id            String   @id @db.Uuid
  collectionId  String   @map("collection_id") @db.Uuid
  /// The resource's URL segment within the collection (decoded).
  name          String
  /// The iCalendar/vCard UID: unique per collection (CALDAV:no-uid-conflict, CARDDAV:no-uid-conflict).
  uid           String
  /// VEVENT, VTODO or VJOURNAL for a calendar object; null for a vCard.
  componentType String?  @map("component_type")
  /// Strong entity tag (quoted on the wire). A fresh random value on every write.
  etag          String
  /// Plaintext size in bytes.
  size          Int
  wrappedDek    Bytes    @map("wrapped_dek")
  kekId         String   @map("kek_id")
  data          Bytes
  /// The collection's syncSeq at this resource's last write.
  modSeq        BigInt   @map("mod_seq")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection DavCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, name])
  @@unique([collectionId, uid])
  @@map("dav_resource")
}

/// The sync-collection change log (RFC 6578): one row per member change, tombstones included, so an
/// incremental sync from any earlier token names every added, modified and removed href.
model DavChange {
  collectionId String   @map("collection_id") @db.Uuid
  seq          BigInt
  name         String
  deleted      Boolean
  at           DateTime @default(now()) @db.Timestamptz(6)

  collection DavCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, seq])
  @@index([collectionId, name])
  @@map("dav_change")
}
